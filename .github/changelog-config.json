{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feature", "enhancement"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["bug", "fix"]
    },
    {
      "title": "## 🔒 Security",
      "labels": ["security"]
    },
    {
      "title": "## 📝 Documentation",
      "labels": ["documentation", "docs"]
    },
    {
      "title": "## 🧪 Tests",
      "labels": ["test", "testing"]
    },
    {
      "title": "## 🔧 Maintenance",
      "labels": ["chore", "maintenance", "dependencies"]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["performance", "optimization"]
    }
  ],
  "ignore_labels": [
    "ignore",
    "wontfix",
    "duplicate"
  ],
  "sort": "ASC",
  "template": "${{CHANGELOG}}\n\n**Full Changelog**: ${{OWNER}}/${{REPO}}/compare/${{FROM_TAG}}...${{TO_TAG}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}}) @${{AUTHOR}}",
  "empty_template": "No changes",
  "label_extractor": [
    {
      "pattern": "^(feat|feature)",
      "label": "feature"
    },
    {
      "pattern": "^fix",
      "label": "bug"
    },
    {
      "pattern": "^docs",
      "label": "documentation"
    },
    {
      "pattern": "^test",
      "label": "test"
    },
    {
      "pattern": "^chore",
      "label": "chore"
    }
  ],
  "duplicate_filter": {
    "pattern": "^(Merge pull request|Merge branch)",
    "on_property": "title",
    "method": "match"
  },
  "transformers": [],
  "max_tags_to_fetch": 200,
  "max_pull_requests": 200,
  "max_back_track_time_days": 365,
  "exclude_merge_branches": [],
  "tag_resolver": {
    "method": "semver"
  },
  "base_branches": []
}